<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/toast.css">

    <link rel="stylesheet" href="/icons/index.css">
    <link rel="stylesheet" href="/font/Montserrat.css">
    <link rel="stylesheet" href="/css/tailwind-fallback.css">

    <title>{{title}} - Colores y Detalles</title>
    <link rel="shortcut icon" href="/img/logo.png" type="image/x-icon">
</head>
<body class="body">
    {{> template-badge}}
    <div id="root">
        <div class="content__body scrollbar">
            {{> header}}
            <main class="main bg-cover bg-no-repeat bg-center  w-full ">
                    <div class="bg-[#ffffff83] min-h-[calc(100vh-90px)]">{{{body}}}</div>
            </main>
            {{> footer}}
        </div>
    </div>
    <div id="popup" class="relative">
            {{> template-toast}}
    </div>
</body>
<script src="/js/index.js" type="module"></script>
<script src="/js/libs/html2pdf.bundle.min.js"></script>
</html>
