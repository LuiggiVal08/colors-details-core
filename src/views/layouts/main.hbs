<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="{{#if description}}{{description}}{{else}}Sistema de gestión para Colores y Detalles - Sublimación y personalización{{/if}}">
    <meta name="theme-color" content="#ec9f9f">
    <meta name="robots" content="index, follow">

    <meta property="og:title" content="{{title}} - Colores y Detalles">
    <meta property="og:description" content="{{#if description}}{{description}}{{else}}Sistema de gestión para Colores y Detalles{{/if}}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Colores y Detalles">

    <link rel="canonical" href="https://coloresydetalles.com{{#if canonical}}{{canonical}}{{else}}/{{/if}}">
    <link rel="shortcut icon" href="/img/logo.png" type="image/x-icon">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/toast.css">
    <link rel="stylesheet" href="/icons/index.css">
    <link rel="stylesheet" href="/font/Montserrat.css">
    <link rel="stylesheet" href="/css/tailwind-fallback.css">

    <title>{{#if title}}{{title}} - Colores y Detalles{{else}}Colores y Detalles - Sistema de Gestión{{/if}}</title>
</head>
<body class="min-h-screen bg-pink-50 text-gray-900 antialiased">
    {{> template-badge}}
    <div id="root">
        <div class="flex flex-col min-h-screen main">
            {{> header}}
            <main id="main-content" class="bg-linear-to-b from-rose-50/60 to-transparent h-full flex-1 flex-col flex">
                {{{body}}}
            </main>
            {{> footer}}
        </div>
    </div>
    <div id="popup">
        {{> template-toast}}
    </div>
</body>
<script src="/js/index.js" type="module"></script>
<script src="/js/libs/html2pdf.bundle.min.js"></script>
</html>
