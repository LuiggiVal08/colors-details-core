<div class='py-4'>
    <div class='container max-w-4xl mx-auto flex flex-col gap-4 justify-center items-center'>
        <div class='rounded-lg bg-red-100 shadow-lg w-full p-6'>
            <div class='flex flex-row gap-4 justify-start items-center'>
                <img src='/img/profile-default.png' alt='profile' class='h-24 rounded-full' />
                <div class='flex flex-col'>
                    <h1 class='text-2xl font-bold text-gray-900'>{{usuario.empleado.nombre}}
                        {{usuario.empleado.apellido}}</h1>

                    <span class='text-gray-900 text-sm'>@{{usuario.username}}</span>

                    <div class='flex flex-row gap-2 items-center text-sm'>
                        <span class='text-gray-900 font-medium'>Empresa:</span>
                        <span class='text-gray-900'>{{empresa.nombre}}</span>
                    </div>
                    <span class='text-gray-900 text-sm'>{{empresa.slogan}}</span>
                    <div class='flex flex-row gap-2 items-center mt-2'>
                        <p
                            class='px-3 py-1 h-fit text-xs text-white rounded-full bg-gray-600 w-fit'
                        >{{usuario.tipo.nombre}}</p>
                        {{#if usuario.empleado.activo}}
                            <p class='px-3 py-1 h-fit text-xs text-white rounded-full bg-green-500 w-fit'>Activo</p>
                        {{else}}
                            <p class='px-3 py-1 h-fit text-xs text-white rounded-full bg-gray-600 w-fit'>Inactivo</p>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
        <div id='tabs-profile' class='flex flex-row items-center justify-center w-full h-10 bg-red-100 p-1 rounded-md'>
            {{> components/tab-btn tab='employee' icon='receipt_long' label='Datos de Empleado'}}
            {{> components/tab-btn tab='security' icon='encrypted' label='Seguridad'}}
            {{> components/tab-btn tab='question' icon='shield_question' label='Preguntas de Seguridad'}}
        </div>
        <!-- Empleado -->
        <div id='tab-employee' class='tab-content w-full hidden'>
                {{> profile/empleado }}
        </div>

        <!-- Seguridad -->
        <div id='tab-security' class='tab-content w-full hidden'>
                {{> profile/seguridad }}
        </div>
        <!-- Preguntas de Seguridad -->
        <div id='tab-question' class='tab-content w-full hidden'>
                {{> profile/question }}
        </div>

    </div>
</div>
<script type='module' src='/js/pages/profile.js'></script>
