<h1 class="sr-only">Configuración</h1>

<div class='container mx-auto py-4'>
    <div class='flex flex-col items-center justify-center gap-4'>
        <div id="tabs-management" class='flex flex-row items-center justify-center w-full h-10 bg-red-100 p-1 rounded-md'>
            {{> components/tab-btn tab='company-info' icon='business' label='Empresa'}}
            {{> components/tab-btn tab='employee-management' icon='badge' label='Empleados'}}
            {{> components/tab-btn tab='user-management' icon='group' label='Usuarios'}}
            {{> components/tab-btn tab='exchange-rate-management' icon='receipt_long' label='Tasa del Dólar'}}
            {{> components/tab-btn tab='iva-management' icon='payment' label='IVA'}}


        </div>
        <div id="tab-company-info" class="tab-content hidden space-y-4 w-full" >
            {{> settings/company-info}}
            {{> settings/services}}
        </div>
        <div id="tab-user-management" class="tab-content hidden w-full">
            {{> settings/user}}
        </div>
        <div id="tab-employee-management" class="tab-content hidden w-full">
            {{> settings/employes}}
        </div>
        <div id="tab-exchange-rate-management" class="tab-content hidden w-full">
            {{> settings/exchange-rate}}
        </div>
        <div id="tab-iva-management" class="tab-content hidden w-full">
            {{> settings/iva}}
        </div>

    </div>
</div>
<script type="module" src="/js/pages/settings/index.js"></script>
