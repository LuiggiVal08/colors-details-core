<div class=''>
    {{#if userValid}}
    <div class="container mx-auto p-4">
        {{!-- <h1 class="text-3xl font-bold mb-6">Dashboard de Estadísticas</h1> --}}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-red-100 p-4 rounded-lg shadow">
                <h2 class="text-xl font-semibold mb-4">Ventas por Fecha</h2>
                <canvas id="salesChart"></canvas>
            </div>
            <div class="bg-red-100 p-4 rounded-lg shadow">
                <h2 class="text-xl font-semibold mb-4">Pedidos por Mes</h2>
                <canvas id="ordersChart"></canvas>
            </div>
            <div class="bg-red-100 p-4 rounded-lg shadow">
                <h2 class="text-xl font-semibold mb-4">Stock por Categoría</h2>
                <canvas id="stockChart" class="max-w-md m-auto"></canvas>
            </div>
            <div class="bg-red-100 p-4 rounded-lg shadow">
                <h2 class="text-xl font-semibold mb-4">Productos con Stock Bajo</h2>
                <canvas id="lowStockChart"></canvas>
            </div>
        </div>
    </div>
    {{else}}
    <div class='container mx-auto flex justify-center items-center min-h-[calc(100vh-90px)]'>
        <div class='text-center rounded-lg p-8 max-w-lg'>
            <img src='/img/logo.png' alt='logo' class='h-48 mb-4 m-auto' style="view-transition-name: home-logo" />
            <h1 class='text-4xl font-bold text-gray-900'>Bienvenido a Colores y Detalles</h1>
            <p class='mt-4 text-lg text-gray-600'>Tu tienda única en sublimado de colores y detalles</p>
        </div>
    </div>
    {{/if}}
</div>
{{> modal }}

<script src="/js/libs/chart-v4.js"></script>
<script type="module" src="/js/pages/home.js"></script>
