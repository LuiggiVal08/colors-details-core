<div class='inset-0 fixed h-screen w-full bg-black/50 content-center hidden backdrop-blur-sm z-50 transition-opacity duration-300'
    id='aside-overlay'>
    <div class='fixed top-0 left-0 h-screen max-w-96 w-full bg-white shadow-2xl z-50 transform transition-transform duration-300 ease-in-out'>
        <div class='flex items-center justify-between h-15 px-4 sticky top-0 z-30 bg-linear-to-r from-pink-50 to-pink-100 border-b border-pink-200'>
            <div class='flex items-center gap-3'>
                <img src='/img/logo.png' alt='Logo' class='h-10 w-10 rounded-full' />
                <div>
                    <span class='text-lg font-semibold tracking-tight text-pink-600'>Colores y Detalles</span>
                    <p class='text-xs text-gray-500'>Sistema de gestión</p>
                </div>
            </div>
            <button data-dismiss='modal' data-ico='menu' type='button'
                class='flex items-center focus:outline-none cursor-pointer material-symbols-rounded leading-0 hover:text-pink-500 transition-colors'
                aria-label='Cerrar menú'>
            </button>
        </div>
        <div class='flex flex-col h-[calc(100%-4rem)] p-4 space-y-4 overflow-y-auto scrollbar'>
            <div class='rounded-xl bg-linear-to-br from-pink-500 to-rose-600 shadow-lg p-4'>
                <div class='flex items-center justify-between text-white'>
                    <div class='flex items-center space-x-2'>
                        <div class='p-2 bg-white/20 rounded-lg'>
                            <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-5 w-5'>
                                <line x1='12' x2='12' y1='2' y2='22'/><path d='M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'/>
                            </svg>
                        </div>
                        <div>
                            <p class='text-sm font-medium text-white/90'>Tasa del Dólar</p>
                            <p class='text-xs text-white/70'>Actualizado ahora</p>
                        </div>
                    </div>
                    <div class='text-right flex flex-col items-end'>
                        <span data-tasa-dolar class='flex items-center font-bold text-white'></span>
                        <span class='inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-white/20 text-white'>VES</span>
                    </div>
                </div>
            </div>

            <nav class='flex-1 space-y-4' aria-label='Navegación principal'>
                {{#if userValid}}
                    <section>
                        <h2 class='text-xs font-semibold text-gray-500 uppercase tracking-wider px-2 mb-2'>Principal</h2>
                        <ul class='bg-white border border-gray-200 shadow-sm rounded-lg w-full py-1'>
                            {{> components/nav-link href='/' icon='home' label='Inicio'}}
                            {{> components/nav-link href='/help' icon='help' label='Ayuda'}}
                            {{> components/nav-link href='/customers' icon='group' label='Clientes'}}
                        </ul>
                    </section>
                    <section>
                        <h2 class='text-xs font-semibold text-gray-500 uppercase tracking-wider px-2 mb-2'>Productos</h2>
                        <ul class='bg-white border border-gray-200 shadow-sm rounded-lg w-full py-1'>
                            {{> components/nav-link href='/inventory' icon='inventory' label='Inventario'}}
                            {{> components/nav-link href='/payments-methods' icon='wallet' label='Métodos de Pago'}}
                        </ul>
                    </section>
                    <section>
                        <h2 class='text-xs font-semibold text-gray-500 uppercase tracking-wider px-2 mb-2'>Gestión</h2>
                        <ul class='bg-white border border-gray-200 shadow-sm rounded-lg w-full py-1'>
                            {{> components/nav-link href='/orders' icon='shopping_cart' label='Pedidos'}}
                            {{> components/nav-link href='/shopping' icon='shopping_bag' label='Ventas'}}
                            {{> components/nav-link href='/payroll' icon='payments' label='Nómina'}}
                        </ul>
                    </section>
                {{else}}
                    <ul class='bg-white border border-gray-200 shadow-sm rounded-lg w-full py-1'>
                        {{> components/nav-link href='/login' icon='login' label='Iniciar Sesión'}}
                        {{> components/nav-link href='/help' icon='help' label='Ayuda'}}
                    </ul>
                {{/if}}
            </nav>

            <div class='pt-4 border-t border-gray-200'>
                <p class='text-xs text-gray-400 text-center'>&copy; 2024 Colores y Detalles</p>
            </div>
        </div>
    </div>
</div>
<script src='/js/aside.js' type='module'></script>
