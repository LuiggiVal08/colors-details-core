<div
    id='modal-create-payment-order'
    class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden'
    inert
>
    <form
        class='bg-white rounded-lg shadow-lg max-w-lg m-auto overflow-auto max-h-[100vh] relative'
        action='/order-payment'
        data-method='POST'
    >
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 class='text-xl font-medium text-gray-900'>Registrar Pago</h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-red-500'
            ></button>
        </div>
        <p class='text-sm text-gray-500 p-6 pb-0'>Registra el pago del pedido aplicando la tasa de cambio actual</p>
        <div role='dialog' class='p-6 space-y-4'>
            <div class='bg-blue-50 border border-blue-200 rounded-lg p-3 text-sm text-blue-800'>
                <p class='font-medium mb-1'>Información Pedido:</p>
                <ul class='text-xs space-y-1'>
                    <li class='flex items-center justify-between'>
                        <span class='font-semibold'>Cliente:</span>
                        <span data-pedido-cliente> </span>
                    </li>
                    <li class='flex items-center justify-between'>
                        <span class='font-semibold'>Fecha:</span>
                        <span data-pedido-fecha>2023-01-01</span>
                    </li>
                    <li class='flex items-center justify-between'>
                        <span class='font-semibold'>Estado:</span>
                        <span data-pedido-estado>Pendiente</span>
                    </li>
                    <li class='flex items-center justify-between'>
                        <span class='font-semibold'>Total:</span>
                        <span data-pedido-total>$ 1,00</span>
                    </li>
                    <li class='flex items-center justify-between'>
                        <span class='font-semibold'>Total Pagado:</span>
                        <span data-pedido-total-pagado>$ 0,00</span>
                    </li>
                    <li class='flex items-center justify-between'>
                        <span class='font-semibold'>Pendiente ($):</span>
                        <span data-pedido-pendiente>$ 0,00</span>
                    </li>
                    <li class='flex items-center justify-between'>
                        <span class='font-semibold'>Pendiente (Bs.):</span>
                        <span data-pedido-pendiente-bs>$ 0,00</span>
                    </li>
                </ul>
            </div>
            <input type='hidden' name='pedido_id' data-valid='text' />

            <div class='w-full'>
                <label for='fecha' class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                    Fecha de pago
                </label>
                <input
                    type='date'
                    name='fecha'
                    data-valid='date'
                    id='fecha'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    required
                />
            </div>

            <div class='w-full'>
                <div class='flex items-center justify-between mb-2'>
                    <span class='text-sm font-medium text-gray-900'>Pagos</span>
                    <button
                        type='button'
                        id='btn-add-pago-pedido'
                        class='inline-flex items-center gap-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-medium rounded-md px-3 py-1.5 cursor-pointer'
                    >
                        <span class='material-symbols-rounded md-18' data-ico='add'></span>
                        Agregar pago
                    </button>
                </div>
                <div id='pagos-pedido' class='flex flex-col gap-3'></div>
                <div class='flex items-center justify-between text-xs text-gray-600 mt-2'>
                    <span>
                        Total a aplicar:
                        <span data-pagos-aplicado class='font-semibold'>$ 0,00</span>
                    </span>
                    <span>
                        Restante:
                        <span data-pagos-restante class='font-semibold'>$ 0,00</span>
                    </span>
                </div>
            </div>

            <div class='bg-yellow-50 border border-yellow-200 rounded-lg p-3'>
                <div class='text-sm text-yellow-800'>
                    <p class='font-medium mb-1'>Información Importante:</p>
                    <ul class='text-xs space-y-1'>
                        <li>
                            Se aplicará la tasa de cambio actual:
                            <span data-info-tasa-cambio class='font-semibold'></span>
                        </li>
                        <li data-caja-status></li>
                        <li>
                            Solo el efectivo admite dólares y mueve la caja; los demás métodos solo se pagan en
            bolívares.
                        </li>
                        <li>Esta acción no se puede deshacer</li>
                    </ul>
                </div>
            </div>
        </div>
        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>
            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400 cursor-pointer'
            >
                Cancelar
            </button>
            {{> components/submit-btn icon='payments' label='Registrar Pago'}}
        </div>
    </form>
</div>

<template id='template-pago-pedido'>
    <div
        class='pago-item flex flex-col gap-3 border border-dashed border-blue-500 bg-blue-400/10 rounded-md p-4'
    >
        <div class='flex flex-col md:flex-row gap-4 items-center w-full'>
            <div class='w-full parent'>
                <label class='block mb-2 text-sm font-medium text-gray-900 text-start'>Método de Pago</label>
                <select
                    type='text'
                    name='pagos[][metodo_pago_id]'
                    data-valid='text'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 w-full p-2 outline-none'
                    required
                >
                    <option value='' selected>Seleccione un método de pago</option>
                    {{#each methodsPayment}}
                        <option value='{{id}}' data-tipo='{{tipo}}'>
                            {{tipo}}
                            -
                            {{nombre}}
                        </option>
                    {{/each}}
                    {{#unless methodsPayment.length}}
                        <option value=''>No hay métodos de pago disponibles</option>
                    {{/unless}}
                </select>
            </div>
            <div class='w-full parent' data-moneda-container>
                <label class='block mb-2 text-sm font-medium text-gray-900 text-start'>Moneda</label>
                <select
                    name='pagos[][moneda]'
                    data-valid='text'
                    class='flex bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    required
                >
                    <option value='USD' selected>$ · USD</option>
                    <option value='VES'>Bs · VES</option>
                </select>
            </div>
            <div class='w-full parent'>
                <label class='block mb-2 text-sm font-medium text-gray-900 text-start' data-monto-label>
                    Monto recibido
                </label>
                <input
                    type='text'
                    name='pagos[][monto]'
                    data-valid='float'
                    class='w-full bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 outline-none'
                    placeholder='0,00'
                    value='0,00'
                    required
                />
            </div>
            <div class='w-full parent' data-vuelto-container>
                <label class='block mb-2 text-sm font-medium text-gray-900 text-start'>Vuelto</label>
                <input
                    type='text'
                    data-role='vuelto'
                    readonly
                    class='w-full bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 outline-none'
                    placeholder='0,00'
                    value='0,00'
                />
                <div data-vuelto-distribucion class='hidden mt-2 grid grid-cols-2 gap-2'>
                    <input type='text' name='pagos[][vuelto_usd]' data-role='vuelto-usd' class='w-full bg-white border border-gray-300 text-sm rounded-lg p-2 outline-none' placeholder='Vuelto $' />
                    <input type='text' name='pagos[][vuelto_bs]' data-role='vuelto-bs' class='w-full bg-white border border-gray-300 text-sm rounded-lg p-2 outline-none' placeholder='Vuelto Bs' />
                </div>
                <p data-role='vuelto-resumen' class='mt-1 text-xs text-gray-600'></p>
            </div>
            <button
                data-ico='delete'
                type='button'
                class='remove-pago text-red-500 text-lg material-symbols-rounded cursor-pointer self-start md:self-center'
                title='Eliminar'
            ></button>
        </div>
        <div class='w-full parent referencia-container hidden' data-referencia-container>
            <label class='block mb-2 text-sm font-medium text-gray-900 text-start'>Referencia</label>
            <input
                type='text'
                name='pagos[][referencia_pago]'
                data-valid='text'
                class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                placeholder='Ingrese la referencia'
                autocomplete='off'
            />
        </div>
    </div>
</template>
