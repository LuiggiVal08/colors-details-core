<div id='modal-update-estado' class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden' inert>
    <form
        class='bg-white rounded-lg shadow-lg max-w-md m-auto overflow-auto max-h-[90vh] relative'
        action='/orders/'
        data-method='PUT'
        id='form-update-estado'
    >
        <!-- HEADER -->
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 class='text-xl font-medium text-gray-900'>Actualizar Estado</h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-red-500'
            ></button>
        </div>

        <!-- BODY -->
        <div role='dialog' class='p-6 space-y-4'>
            <div class='w-full'>
                <label class='block mb-2 text-sm font-medium text-gray-900'>
                    Estado del Pedido
                </label>
                <select
                    name='estado'
                    id='estado_order'
                    data-valid='text'
                    class='w-full bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 outline-none focus:ring-red-400 focus:border-red-400'
                    required
                >
                    <option value=''>Seleccione</option>
                    <option value='procesado'>Procesado</option>
                    <option value='completado'>Completado</option>
                </select>
            </div>
        </div>

        <!-- FOOTER -->
        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>
            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400'
            >
                Cancelar
            </button>
            {{> components/submit-btn icon='sync' label='Actualizar Estado'}}
        </div>
    </form>
</div>
