<div id='modal-create-order' class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden' inert>
    <form
        class='bg-white rounded-lg shadow-lg max-w-2xl m-auto overflow-auto max-h-[100vh] relative'
        action='/orders'
        data-method='POST'
        id='pedido-form'
    >
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 class='text-xl font-medium text-gray-900'>Crear Pedido</h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-red-500'
            ></button>
        </div>

        <div role='dialog' class='p-6 space-y-4'>
            <input type='hidden' name='iva_id' value='{{iva.id}}' data-valid='text' />
            <input type='hidden' name='iva_porcentaje' value='{{iva.porcentaje}}' data-valid='text' />
            <input type='hidden' name='usuario_id' value='{{user.id}}' data-valid='text' />
            <div class='flex flex-col gap-4'>
                <div class='w-full'>
                    <label for='input_busqueda' class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                        Buscar cliente
                    </label>
                    <input
                        type='text'
                        id='input_busqueda'
                        data-valid='text'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese nombre, apellido o cédula'
                        autocomplete='off'
                        required
                    />

                    <!-- Resultados dinámicos -->
                    <div
                        id='resultados_cliente'
                        class='mt-2 bg-white border border-gray-300 rounded-md shadow-sm hidden max-h-56 overflow-y-auto divide-y divide-gray-200'
                    ></div>

                    <!-- Aviso de cliente no encontrado -->
                    <div
                        id='sin-resultados-cliente'
                        class='border border-dashed border-blue-500 bg-blue-400/10 rounded-md shadow-sm min-h-10 p-4 w-full flex-col gap-1 flex mt-2'
                    >
                        <div class='flex flex-row items-center gap-1'>
                            <span
                                data-ico='info'
                                class='material-symbols-rounded md-18 text-blue-500 leading-none'
                            ></span>
                            <span class='font-semibold'>Sin resultados del cliente:</span>
                        </div>
                        <span class='text-sm text-gray-700'>
                            El cliente no tiene resultados registrados. Por favor, registre el cliente primero.
                        </span>
                        <a
                            href='/customers?open-create=true'
                            class='text-blue-500 text-center m-auto hover:text-blue-700 duration-300'
                        >
                            Registrar Cliente
                        </a>
                    </div>

                    <!-- Campo oculto para guardar el ID del cliente seleccionado -->
                    <input type='hidden' name='cliente_id' id='cliente_id' />
                </div>
                <div class='w-full'>
                    <label for='obser' class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                        Observaciones
                    </label>
                    <textarea
                        id='obser'
                        data-valid='text'
                        name='observaciones'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Observaciones'
                        required
                    ></textarea>
                </div>
                <div class='w-full'>
                    <label for='fecha_entrega' class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                        Fecha Entrega
                    </label>
                    <input
                        id='fecha_entrega'
                        data-valid='date'
                        type='date'
                        name='fecha_entrega'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Fecha Entrega'
                        required
                    ></input>
                </div>

                <div id='detalles-pedido' class='space-y-4'>
                </div>
                <button
                    type='button'
                    id='btn-add-producto'
                    data-ico='add'
                    class='text-sm text-white bg-green-500 hover:bg-green-600 px-4 py-2 rounded-lg material-symbols-rounded cursor-pointer flex items-center gap-2 justify-center'
                >
                    Agregar producto
                </button>
                <div class='flex flex-row gap-2 items-center'>
                    <div class='w-full'>
                        <label for='total' class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                            Total $ (sin IVA)
                        </label>
                        <input
                            type='text'
                            name='total'
                            id='total'
                            class='w-full bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 outline-none'
                            placeholder='Total'
                            data-valid='float'
                            value='0,00'
                            readonly
                        />
                    </div>
                    <span data-ico='arrow_forward' class='material-symbols-rounded text-blue-500 leading-none'></span>
                    {{iva.porcentaje}}%
                    <span data-ico='arrow_forward' class='material-symbols-rounded text-blue-500 leading-none'></span>

                    <div class='w-full'>
                        <label for='totalMasIVA' class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                            Total ($) + IVA (%)
                        </label>
                        <input
                            type='text'
                            name='totalMasIVA'
                            id='totalMasIVA'
                            class='w-full bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 outline-none text-right'
                            placeholder='0,00'
                            data-valid='float'
                            value='0,00'
                            readonly
                        />
                    </div>
                </div>
                <div class='w-full'>
                    <label for='total_bs' class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                        Total en Bs.
                    </label>
                    <input
                        type='text'
                        name='total_bs'
                        id='total_bs'
                        data-value='{{tasaDolar.tasa}}'
                        class='w-full bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 outline-none'
                        placeholder='Total'
                        data-valid='float'
                        value='0,00'
                        readonly
                    />

                </div>

            </div>

        </div>
        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>
            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400 cursor-pointer'
            >
                Cancelar
            </button>
            <button
                data-confirm='modal'
                type='submit'
                class='inline-block bg-red-400 hover:bg-red-500 text-white px-4 py-2 rounded-md cursor-pointer'
            >
                Crear Pedido
            </button>
        </div>
    </form>
</div>
<!-- TEMPLATE PARA DETALLES DE PEDIDO -->
<template id='template-detalle-producto'>
    <div class='detalle-item grid grid-cols-1 gap-2 rounded-md border border-dashed border-blue-500 bg-blue-400/10 p-3 shadow-sm md:grid-cols-[2.2fr_0.8fr_0.9fr_1.2fr_0.9fr_auto] items-center'>
        <div class='relative md:col-span-1'>
            <label class='sr-only'>Código o nombre del producto</label>
            <input
                type='text'
                name='detalles[][codigo]'
                class='codigo-input w-full bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 p-2 outline-none'
                placeholder='Buscar producto por nombre o código'
                data-valid='text'
                required
            />
            <div
                class='resultados-productos absolute z-50 mt-1 w-full bg-white border border-gray-200 rounded-md shadow-lg hidden max-h-64 overflow-y-auto'
            ></div>
            <input type='hidden' name='detalles[][producto_id]' class='producto-id-hidden' />
        </div>

        <div class='grid grid-cols-1 gap-2 md:grid-cols-[0.9fr_0.9fr_1.5fr_0.9fr] md:col-span-4 hidden' data-producto>
            <div class='parent'>
                <label class='sr-only'>Cantidad</label>
                <input
                    type='number'
                    name='detalles[][cantidad]'
                    class='w-full bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 p-2 outline-none'
                    placeholder='Cant.'
                    data-valid='number'
                    min='1'
                    required
                />
            </div>
            <div class='parent'>
                <label class='sr-only'>Precio Unitario ($)</label>
                <input
                    type='text'
                    name='detalles[][precio_unitario]'
                    step='0.01'
                    class='w-full bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 outline-none'
                    placeholder='Precio Unitario ($)'
                    data-valid='float'
                    readonly
                    required
                />
            </div>
            <div class='parent'>
                <label class='sr-only'>Detalle del Sublimado / Personalización</label>
                <input
                    type='text'
                    name='detalles[][detalle_pedido_producto]'
                    class='w-full bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 p-2 outline-none'
                    placeholder='Detalle / Personalización (opcional)'
                />
            </div>
            <div class='grid grid-cols-1 gap-2 md:grid-cols-[0.9fr_0.9fr]'>
                <div class='parent'>
                    <label class='sr-only'>Precio Sublimado ($)</label>
                    <input
                        type='text'
                        name='detalles[][precio_pedido_producto]'
                        class='w-full bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 p-2 outline-none'
                        placeholder='Precio Sublimado ($)'
                        data-valid='float'
                        value='0,00'
                    />
                </div>
                <div class='parent'>
                    <label class='sr-only'>Subtotal ($)</label>
                    <input
                        type='text'
                        name='detalles[][subtotal]'
                        class='w-full bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 outline-none'
                        placeholder='Subtotal ($)'
                        data-valid='float'
                        readonly
                    />
                </div>
            </div>
        </div>

        <button
            data-ico='delete'
            type='button'
            class='remove-detalle text-red-500 text-lg material-symbols-rounded cursor-pointer self-start md:self-center'
            title='Eliminar'
        ></button>
    </div>
</template>
