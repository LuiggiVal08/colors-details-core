<div
    id='modal-create-employee-payroll'
    class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden'
    inert
>
    <form
        class='bg-white rounded-lg shadow-lg max-w-lg m-auto overflow-auto max-h-[100vh] relative'
        action='/employee-payroll'
        data-method='POST'
    >
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 class='text-xl font-medium text-gray-900'>Registrar Nómina</h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-red-500'
            ></button>
        </div>

        <div role='dialog' class='p-6 space-y-4'>
            <input type='hidden' name='empleado_id' value='{{employe.id}}' />
            <div class='flex gap-4 flex-row w-full'>
                <div class='w-full'>
                    <label
                        for='fecha_inicio_payment_method_create'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Fecha de Inicio</label>
                    <input
                        type='date'
                        name='fecha_inicio'
                        data-valid='date'
                        id='fecha_inicio_payment_method_create'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Fecha de Inicio'
                        required
                    />
                </div>
                <div class='w-full'>
                    <label
                        for='fecha_fin_payment_method_create'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Fecha de Fin</label>
                    <input
                        type='date'
                        name='fecha_fin'
                        data-valid='date'
                        id='fecha_fin_payment_method_create'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Fecha de Fin'
                        required
                    />
                </div>

            </div>
            <div class='flex gap-4 flex-row w-full items-center'>
                <div class='w-full'>
                    <label
                        for='monto_payment_method_create'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Monto (Bs.)</label>
                    <input
                        type='text'
                        name='monto'
                        data-valid='float'
                        id='monto_payment_method_create'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='0,00'
                        required
                    />
                </div>
                <span class='material-symbols-rounded text-gray-500 text-sm font-medium' data-ico='swap_horiz'></span>
                <div class='w-full'>
                    <label
                        for='monto_payment_method_create_usd'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Monto (USD)</label>
                    <input
                        type='text'
                        name='monto'
                        data-valid='float'
                        id='monto_payment_method_create_usd'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='0,00'
                        required
                    />
                </div>
            </div>

            <div class=''>
                <label
                    for='descripcion_payment_method_create'
                    class='block mb-2 text-sm font-medium text-gray-900 text-start'
                >Descripción</label>
                <textarea
                    type='text'
                    name='descripcion'
                    data-valid='text'
                    id='descripcion_payment_method_create'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    placeholder='Ingrese la descripción'
                    required
                ></textarea>
            </div>

        </div>
        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>
            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400 cursor-pointer'
            >
                Cancelar
            </button>
            <button
                data-confirm='modal'
                type='submit'
                class='inline-block bg-red-400 hover:bg-red-500 text-white px-4 py-2 rounded-md cursor-pointer'
            >
                Registrar Nómina
            </button>
        </div>
    </form>
</div>
