<div id='exchange-rate-modal' class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden' inert>
    <form
        class='bg-white rounded-lg shadow-lg max-w-lg m-auto overflow-auto max-h-[100vh] relative'
        action='/exchange-rate'
        data-method='POST'
    >
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 class='text-xl font-medium text-gray-900'>Actualizar Tasa del Dólar</h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-green-500'
            ></button>
        </div>

        <div role='dialog' class='p-6 pt-2 space-y-4'>
            <span class='text-sm text-gray-600'>Ingresa el nuevo valor de la tasa USD/BS</span>
            <input type='hidden' name='usuario_id' value='{{user.id}}' />
            <div class='w-full'>
                <label for='tasa_dollar_update' class='block mb-2 text-sm font-medium text-gray-900 text-start'>Nueva
                    Tasa (BS por USD)</label>

                <input
                    type='text'
                    name='tasa'
                    data-valid='float'
                    id='tasa_dollar_update'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none text-right'
                    placeholder='0,00'
                    required
                />
            </div>

        </div>
        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>
            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400 cursor-pointer'
            >
                Cancelar
            </button>
            <button
                data-confirm='modal'
                type='submit'
                class='inline-block bg-red-400 hover:bg-red-500 text-white px-4 py-2 rounded-md cursor-pointer duration-300'
            >
                Actualizar Tasa
            </button>
        </div>
    </form>
</div>
