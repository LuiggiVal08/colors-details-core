{{> settings/iva-register}}
<div class='bg-red-100 shadow-lg rounded-lg p-6 w-full flex-col gap-4 flex'>
    {{! titulo y descripcion }}
    <div class=''>
        <div class='flex flex-row gap-4'>
            <span data-ico='calculate' class='material-symbols-rounded md-28'></span>
            <h3 class='text-xl font-medium text-gray-900'>Gestión de IVA</h3>
        </div>
        <span>Configura y actualiza el porcentaje de IVA</span>
    </div>
    {{! Card de tasa actual }}
    <div class='flex flex-col md:flex-row gap-4 w-full '>

        <div class='w-full border border-blue-500 bg-blue-400/10 rounded-md shadow-s min-h-10m flex flex-col p-4 gap-1' id="actual-iva-container">
            <h4 class='font-semibold'>IVA Actual</h4>
            <span class='font-bold text-2xl my-1 text-blue-500'l>{{ ivaActual.porcentaje }}%</span>
            <span>Vigente desde: {{ ivaActual.fecha }}</span>
            <span>Por: {{ ivaActual.usuario.username }}</span>
            <span class='text-sm bg-white rounded-md shadow-sm p-2 flex flex-row gap-2'>{{ ivaActual.observacion }}</span>
        </div>

        <div class='w-full flex flex-col gap-4 '>
            <button
                type='button'
                data-ico='edit'
                id='update-iva'
                class='cursor-pointer flex items-center justify-center gap-2 w-full h-10 text-white font-semibold bg-red-400 hover:bg-red-500 hover:text-white rounded-md transition-colors duration-200 material-symbols-rounded'
            >
                Actualizar Iva
            </button>
            <div
                class='border border-dashed border-blue-500 bg-blue-400/10 rounded-md shadow-sm min-h-10 p-4 w-full flex flex-col gap-1'
            >
                <div class='flex flex-row items-center gap-1'>
                    <span data-ico='info' class='material-symbols-rounded md-18 text-blue-500 leading-none'></span>
                    <span class='font-semibold'>Nota:</span>
                </div>
                <ul class='list-disc list-inside text-sm text-gray-700'>
                    <li>El IVA se aplica automáticamente en ventas y facturación</li>
                    <li>Los cambios quedan registrados en el historial</li>
                    <li>Solo puede haber un IVA activo a la vez</li>
                </ul>
            </div>
        </div>
    </div>
    {{! historial de cambios }}
    <div class='flex-col gap-4 flex'>
        <div class='overflow-x-auto scrollbar rounded-md border border-red-400/50'>
            <table class='w-full border-collapse table caption-bottom'>
                <thead class='[&_tr]:border-b border-red-400/50'>
                    <tr class='border-b border-red-400/50'>
                        <th align='start' class='text-gray-900 font-medium p-3'>IVA (%)</th>
                        <th align='center' align='start' class='text-gray-900 font-medium p-3'>Vigencia</th>
                        <th align='center' class='text-gray-900 font-medium p-3'>Observación</th>
                        <th align='end' class='text-gray-900 font-medium p-3'>Usuario</th>
                    </tr>
                </thead>
                <tbody id='table-iva' class='[&_tr:last-child]:border-0'>
                    <tr class='border-b transition-colors'>
                        <td colspan='4' class='text-center p-3'>Cargando...</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class='w-full flex justify-end items-center gap-2' id='paginador-tabla-iva'>
            <button data-ico="arrow_back" class='cursor-pointer flex items-center justify-center gap-2 w-fit h-10 text-white font-semibold bg-red-400 hover:bg-red-500 hover:text-white rounded-md transition-colors duration-200 material-symbols-rounded disabled:opacity-30 border border-transparent  px-4 disabled:cursor-not-allowed btn-paginar leading-0 disabled:hover:bg-red-400' disabled>Anterior</button>
            <button data-ico="arrow_forward" class='cursor-pointer flex items-center justify-center gap-2 w-fit h-10 text-white font-semibold bg-red-400 hover:bg-red-500 hover:text-white rounded-md transition-colors duration-200 material-symbols-rounded disabled:opacity-30 border border-transparent  px-4 disabled:cursor-not-allowed btn-paginar leading-0 disabled:hover:bg-red-400' disabled>Siguiente</button>
        </div>
    </div>
</div>
<template id='fila-ejemplo-iva'>
    <tr class='hover:bg-pink-400/10 transition-all duration-300 border-b border-red-400/50'>
        <td align='start' class='p-4 align-middle max-w-xs truncate text-nowrap' data-key='porcentaje'></td>
        <td align='center' class='p-4 align-middle max-w-xs truncate text-nowrap' data-key='fecha'></td>
        <td align='center' class='p-4 align-middle max-w-xs truncate text-nowrap' data-key='observacion'></td>
        <td align='end' class='p-4 align-middle max-w-xs truncate text-nowrap' data-key='usuario'></td>

    </tr>
</template>

</template>
<script type='module' src='/js/pages/settings/iva.js'></script>
