{{> settings/employes-create}}
{{> settings/employes-edit}}
<div class='bg-red-100 shadow-lg rounded-lg p-6 w-full flex-col gap-4 flex'>
    <div class='flex justify-between items-center'>
        <div class='flex items-center gap-2'>
            <h2 class='text-xl font-medium text-gray-900'>Empleados</h2>
            <span class='material-symbols-rounded fill-solid wght-normal md-28 ico-group text-gray-900'></span>
        </div>
        <div class='flex items-center justify-end gap-4'>
            <input
                type='text'
                name='code'
                id='search-employe'
                placeholder='Buscar por cedula o nombre'
                class='bg-red-200 border border-red-300 text-gray-900 text-sm rounded-lg focus:ring-red-300 focus:border-red-400 block w-full p-2 outline-none'
            />
            <button
                type='button'
                id='btn-add-employe'
                data-ico="add"
                class=' bg-red-400 hover:bg-red-500 duration-300 text-white px-4 py-2 rounded-md text-nowrap cursor-pointer material-symbols-rounded flex items-center justify-center'
            >Agregar Empleado</button>
        </div>
    </div>
    <div class='overflow-x-auto scrollbar  rounded-md border border-red-400/50 '>
        <table class='w-full border-collapse table caption-bottom'>
            <thead class="[&_tr]:border-b border-red-400/50">
                <tr class="border-b border-red-400/50">
                    <th align='start' class='text-gray-900 font-medium p-3 text-nowrap'>Nombre y Apellido</th>
                    <th align='start' class='text-gray-900 font-medium p-3 text-nowrap'>Cedula</th>
                    <th align='start' class='text-gray-900 font-medium p-3 text-nowrap'>Contacto</th>
                    <th align='center' class='text-gray-900 font-medium p-3 text-nowrap'>Salario Base</th>
                    <th align='center' class='text-gray-900 font-medium p-3 text-nowrap'>Activo</th>
                    <th align='center' class='text-gray-900 font-medium p-3 text-nowrap'>Acciones</th>
                </tr>
            </thead>
            <tbody id='table-customers' class="[&_tr:last-child]:border-0">
                <tr class="border-b transition-colors border-red-400/50">
                    <td colspan='7' class='text-center p-3'>Cargando...</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class='w-full flex justify-end items-center gap-2' id='paginador-tabla-empleados'>
        <button data-ico="arrow_back" class='cursor-pointer flex items-center justify-center gap-2 w-fit h-10 text-white font-semibold bg-red-400 hover:bg-red-500 hover:text-white rounded-md transition-colors duration-200 material-symbols-rounded disabled:opacity-30 border border-transparent  px-4 disabled:cursor-not-allowed btn-paginar leading-0 disabled:hover:bg-red-400' disabled>Anterior</button>
        <button data-ico="arrow_forward" class='cursor-pointer flex items-center justify-center gap-2 w-fit h-10 text-white font-semibold bg-red-400 hover:bg-red-500 hover:text-white rounded-md transition-colors duration-200 material-symbols-rounded disabled:opacity-30 border border-transparent  px-4 disabled:cursor-not-allowed btn-paginar leading-0 disabled:hover:bg-red-400' disabled>Siguiente</button>
    </div>
</div>

<template id='templete-fila-empleados'>
    <tr data-id='{{id}}' class='hover:bg-pink-400/10 transition-all duration-300 border-b border-red-400/50'>
        {{! <td data-key='id' class='hidden'></td> }}
        {{! <td data-key='foto' data-tipo='imagen' data-baseimg='/img/' class='rounded-full size-4 overflow-hidden'></td> }}
        <td align='start' class=' p-4 align-middle max-w-xs truncate  text-nowrap' data-key='nombre'></td>
        <td align='start' class=' p-4 align-middle max-w-xs truncate text-nowrap' data-key='cedula' class='text-nowrap'></td>
        <td align='start' class=' p-4 align-middle max-w-xs truncate  text-nowrap' data-key='contacto'></td>
        <td align='center' class=' p-4 align-middle max-w-xs truncate  text-nowrap' data-key='salario_base'></td>
        <td align='center' class=' p-4 align-middle max-w-xs truncate  text-nowrap' data-key='activo'></td>

        <td align='center' class='px-3 py-1 text-nowrap'>
            <div class='flex gap-2 flex-row items-center justify-center'>
                <button data-ico='visibility' data-btn='view' data-idfield='id' class='cursor-pointer material-symbols-rounded fill-solid wght-normal md-28 text-blue-500 hover:text-blue-700 duration-300' ></button>
                <button data-ico='edit' data-btn='editar' data-idfield='id' class='cursor-pointer material-symbols-rounded fill-solid wght-normal md-28 text-gray-700 hover:text-gray-500 duration-300' ></button>
            </div>
        </td>
    </tr>
</template>

<script type='module' src='/js/pages/settings/employes.js'></script>
