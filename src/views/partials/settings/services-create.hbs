<div id='modal-create-service' class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden' inert>
    <form
        data-state='closed'
        class='bg-white rounded-lg shadow-lg max-w-lg m-auto overflow-auto max-h-[100vh] relative data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[state=closed]:slide-out-to-left-1/2 data-[state=closed]:slide-out-to-top-[48%] data-[state=open]:slide-in-from-left-1/2 data-[state=open]:slide-in-from-top-[48%]'
        action='/service'
        data-method='POST'
    >
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 class='text-xl font-medium text-gray-900'>Registrar Servicio de la Empresa</h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-red-500'
            ></button>
        </div>

        <div role='dialog' class='p-6 space-y-4'>
            <input type='hidden' name='empresa_id' value='{{company.id}}' />
            <input type='hidden' name='usuario_id' value='{{user.id}}' />

            <div class='flex flex-col md:flex-row w-full items-center gap-4'>
                <!-- Nombre -->
                <div class='w-full'>
                    <label
                        for='nombre_service_create'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Nombre</label>
                    <input
                        type='text'
                        name='nombre'
                        data-valid='text'
                        id='nombre_service_create'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Nombre'
                        required
                    />
                </div>
                <!-- Proveedor -->
                <div class='w-full'>
                    <label
                        for='proveedor_service_create'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Proveedor</label>
                    <input
                        type='text'
                        name='proveedor'
                        data-valid='name'
                        id='proveedor_service_create'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Proveedor'
                        required
                    />
                </div>
            </div>

            <div class='flex flex-col md:flex-row w-full items-center gap-4'>
                <!-- Costo -->
                <div class='w-full'>
                    <label
                        for='costo_service_create'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Costo del Servicio (USD)</label>
                    <input
                        type='text'
                        step='0.01'
                        min='0'
                        name='precio'
                        data-valid='float'
                        id='costo_service_create'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none text-right'
                        placeholder='5,00'
                        required
                    />
                </div>
                <!-- Día de Corte -->
                <div class='w-full'>
                    <label
                        for='dia_corte_service_create'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Día de Corte</label>
                    <input
                        type='number'
                        name='dia_corte'
                        id='dia_corte_service_create'
                        data-valid='number'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ej: 10'
                        min='1'
                        max='31'
                        required
                    />
                </div>
            </div>
            <!-- Descripción -->
            <div class=''>
                <label
                    for='descripcion_service_create'
                    class='block mb-2 text-sm font-medium text-gray-900 text-start'
                >Descripción</label>
                <textarea
                    name='descripcion'
                    data-valid='text'
                    id='descripcion_service_create'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    placeholder='Ingrese la Descripción'
                    required
                ></textarea>
            </div>
        </div>

        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>
            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400 cursor-pointer'
            >
                Cancelar
            </button>
            {{> components/submit-btn icon='add' label='Registrar Servicio'}}
        </div>
    </form>
</div>
