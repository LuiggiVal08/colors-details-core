<div id='modal-edit-service' class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden' inert>
    <form
        class='bg-white rounded-lg shadow-lg max-w-lg m-auto overflow-auto max-h-[100vh] relative'
        action='/service'
        data-method='PUT'
    >
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 class='text-xl font-medium text-gray-900'>Editar Servicio de la Empresa</h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-red-500'
            ></button>
        </div>

        <div role='dialog' class='p-6 space-y-4'>
            <input type='hidden' name='empresa_id' />
            <!-- ID del servicio a editar -->

            <div class='flex w-full flex-row items-center gap-4'>
                <!-- Nombre -->
                <div class='w-full'>
                    <label
                        for='nombre_service_edit'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Nombre</label>
                    <input
                        type='text'
                        name='nombre'
                        data-valid='text'
                        id='nombre_service_edit'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Nombre'
                        required
                    />
                </div>
                <!-- Proveedor -->
                <div class='w-full'>
                    <label
                        for='proveedor_service_edit'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Proveedor</label>
                    <input
                        type='text'
                        name='proveedor'
                        data-valid='name'
                        id='proveedor_service_edit'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Proveedor'
                        required
                    />
                </div>
            </div>

            <div class='flex w-full flex-row items-center gap-4'>
                <!-- Costo -->
                <div class='w-full'>
                    <label
                        for='costo_service_edit'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Costo del Servicio (USD)</label>
                    <input
                        type='text'
                        step='0.01'
                        min='0'
                        name='coste'
                        data-valid='float'
                        id='costo_service_edit'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none text-right'
                        placeholder='5,00'
                        required
                    />
                </div>
                <!-- Día de Corte -->
                <div class='w-full'>
                    <label
                        for='dia_corte_service_edit'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Día de Corte</label>
                    <input
                        type='number'
                        name='dia_corte'
                        id='dia_corte_service_edit'
                        data-valid='number'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ej: 10'
                        min='1'
                        max='31'
                        required
                    />
                </div>
            </div>

            <!-- Descripción -->
            <div>
                <label
                    for='descripcion_service_edit'
                    class='block mb-2 text-sm font-medium text-gray-900 text-start'
                >Descripción</label>
                <textarea
                    name='descripcion'
                    data-valid='text'
                    id='descripcion_service_edit'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    placeholder='Ingrese la Descripción'
                    required
                ></textarea>
            </div>
        </div>

        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>
            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400 cursor-pointer'
            >
                Cancelar
            </button>
            <button
                data-confirm='modal'
                type='submit'
                class='inline-block bg-red-400 hover:bg-red-500 text-white px-4 py-2 rounded-md cursor-pointer'
            >
                Guardar Cambios
            </button>
        </div>
    </form>
</div>
