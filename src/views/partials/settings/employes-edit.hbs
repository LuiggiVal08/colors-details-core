<div id='modal-edit-employe' class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden' inert>
    <form
        class='bg-white rounded-lg shadow-lg max-w-lg m-auto overflow-auto max-h-[100vh] relative'
        action='/employe'
        data-method='PUT'
    >
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 class='text-xl font-medium text-gray-900'>Editar Empleado</h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-red-500'
            ></button>
        </div>

        <div role='dialog' class='p-6 space-y-4'>
            <div class=''>
                <label
                    for='cedula_employee_edit'
                    class='block mb-2 text-sm font-medium text-gray-900 text-start'
                >Cédula</label>
                <input
                    type='text'
                    name='cedula'
                    data-valid='dni'
                    id='cedula_employee_edit'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
placeholder='Ingrese la Cédula'
                    required
                />
            </div>
<div class='flex flex-col md:flex-row gap-4 w-full'>
                <input type='hidden' name='fecha_ingreso' />
                <div class='w-full'>
                    <label
                        for='nombre_employee_edit'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Nombre</label>
                    <input
                        type='text'
                        name='nombre'
                        data-valid='name'
                        id='nombre_employee_edit'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Nombre'
                        required
                    />
                </div>
                <div class='w-full'>
                    <label
                        for='apellido_employee_edit'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Apellido</label>
                    <input
                        type='text'
                        name='apellido'
                        data-valid='name'
                        id='apellido_employee_edit'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Apellido'
                        required
                    />
                </div>
            </div>

            <div class='flex flex-col md:flex-row gap-4 w-full'>
                <div class='w-full'>
                    <label
                        for='telefono_employee_edit'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Teléfono</label>
                    <input
                        type='text'
                        name='telefono'
                        data-valid='phone'
                        id='telefono_employee_edit'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Teléfono'
                        required
                    />
                </div>
                <div class='w-full'>
                    <label
                        for='email_employee_edit'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Correo</label>
                    <input
                        type='text'
                        name='email'
                        data-valid='email'
                        id='email_employee_edit'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Correo'
                        required
                    />
                </div>
            </div>
            <div class=''>
                <label
                    for='direccion_employee_edit'
                    class='block mb-2 text-sm font-medium text-gray-900 text-start'
                >Dirección</label>
                <textarea
                    type='text'
                    name='direccion'
                    data-valid='text'
                    id='direccion_employee_edit'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    placeholder='Ingrese la Dirección'
                    required
                ></textarea>
            </div>
            <div class='flex flex-col md:flex-row gap-4 w-full'>
                <div class='w-full'>
                    <label
                        for='salario_employee_edit'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Salario base ($)</label>
                    <input
                        type='text'
                        name='salario_base'
                        data-valid='float'
                        id='salario_employee_edit'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none text-right'
                        placeholder='0,00'
                        required
                    />
                </div>
                <div class='w-full'>
                    <label
                        for='frecuencia_employee_edit'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Frecuencia de Pago</label>
                    <select
                        name='frecuencia_pago'
                        id='frecuencia_employee_edit'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    >
                        <option value='mensual'>Mensual</option>
                        <option value='quincenal'>Quincenal</option>
                        <option value='semanal'>Semanal</option>
                    </select>
                </div>
            </div>
            <div class=''>
                <label for='activo_employee_edit' class='block mb-2 text-sm font-medium text-gray-900'>
                    Empleado activo
                </label>
                <label class='inline-flex items-center cursor-pointer relative'>
                    <!-- input invisible -->
                    <input
                        type='checkbox'
                        data-valid='boolean'
                        id='activo_employee_edit'
                        name='activo'
                        class='sr-only peer'
                    />

                    <!-- fondo del switch -->
                    <div
                        class='w-11 h-6 bg-gray-300 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-blue-500 rounded-full peer peer-checked:bg-green-500 relative transition-colors duration-300'
                    >
                        <!-- pelotica -->
                    </div>
                    <div
                        class='absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full transition-transform duration-300 peer-checked:translate-x-5'
                    ></div>

                    <!-- texto al lado -->
                    <span class='ml-3 text-sm text-gray-700'>Activo</span>
                </label>
            </div>
        </div>
        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>
            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400 cursor-pointer'
            >
                Cancelar
            </button>
            {{> components/submit-btn icon='save' label='Editar Empleado'}}
        </div>
    </form>
</div>
