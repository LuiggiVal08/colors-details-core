{{> settings/user-create}}
{{> settings/user-edit}}
<div class='bg-red-100 shadow-lg rounded-lg p-6 w-full flex-col gap-4 flex'>
    <div class='flex flex-row items-center justify-between'>
        <div class=''>
            <div class='flex flex-row gap-4'>
                <span data-ico='group' class='material-symbols-rounded md-28'></span>
                <h3 class='text-xl font-medium text-gray-900'>Usuarios</h3>
            </div>
            <span>Gestiona los usuarios</span>
        </div>
        <div class='flex flex-row items-center gap-2'>
            <input
                type='text'
                name='code'
                id='searchUsers'
                placeholder='Buscar Usuario'
                class='bg-red-300/30 border border-pink-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
            />
            <button
                type='button'
                data-ico='add'
                id='btn-add-user'
                class='material-symbols-rounded bg-red-400 hover:bg-red-500 duration-300 text-white px-4 py-2 rounded-md text-nowrap cursor-pointer flex items-center gap-2'
            >
                Agregar Usuario
            </button>
        </div>
    </div>
    <div class='overflow-x-auto scrollbar rounded-md border border-red-400/50'>
        <table class='w-full border-collapse table caption-bottom'>
            <thead class="[&_tr]:border-b border-red-400/50">
                <tr class="border-b border-red-400/50">
                    <th align='start' align='start' class='text-gray-900 font-medium p-3'>Nombre de Usuario</th>
                    <th align='center' class='text-gray-900 font-medium p-3'>Empleado</th>
                    <th align='center' class='text-gray-900 font-medium p-3'>Tipo de Usuario</th>
                    <th align='center' class='text-gray-900 font-medium p-3'>Estado</th>
                    <th align='center' class='text-gray-900 font-medium p-3'>Acciones</th>
                </tr>
            </thead>
            <tbody id='table-user' class="[&_tr:last-child]:border-0">
                {{! Aquí se insertarán las filas dinámicamente }}
                <tr class="border-b transition-colors">
                    <td colspan='6' class='text-center p-3'>Cargando...</td>
                </tr>
            </tbody>
        </table>
    </div>
        {{> components/pagination id='paginador-tabla-user' disablePrev=true disableNext=true}}
</div>
<template id='template-user'>
    <tr class='hover:bg-pink-400/10 transition-all duration-300 border-b border-red-400/50'>
        <td align='start' class='p-4 align-middle max-w-xs truncate text-nowrap' data-key='username'></td>
        <td align='center' class='p-4 align-middle max-w-xs truncate text-nowrap' data-key='empleado'></td>
        <td align='center' class='p-4 align-middle max-w-xs truncate text-nowrap' data-key='tipo_usuario'></td>
        <td align='center' class='p-4 align-middle max-w-xs truncate text-nowrap' data-key='activo' data-tipo='html'></td>
        <td align='center' class='p-4 align-middle max-w-xs truncate text-nowrap'>
            <div class='flex gap-2 flex-row items-center justify-center'>
                <button data-btn='editar' data-idfield='id' class='cursor-pointer'>
                    <span
                        class='material-symbols-rounded fill-solid wght-normal md-28 text-gray-700 hover:text-gray-500'
                        data-ico='edit'
                    ></span>
                </button>

            </div>
        </td>
    </tr>
</template>
<script type='module' src='/js/pages/settings/user.js'></script>
