<div id='modal-create-user' class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden' inert>
    <form
        class='bg-white rounded-lg shadow-lg max-w-lg m-auto overflow-auto max-h-[100vh] relative'
        action='/user'
        data-method='POST'
    >
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 class='text-xl font-medium text-gray-900'>Registrar Usuario</h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-red-500'
            ></button>
        </div>

        <div role='dialog' class='p-6 space-y-4'>
            <div class='w-full flex flex-col md:flex-row gap-4'>
                <div class='w-full'>
                    <label
                        for='username_user_create'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Nombre de Usuario</label>
                    <input
                        type='text'
                        name='username'
                        data-valid='username'
                        id='username_user_create'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Nombre de Usuario'
                        required
                    />
                </div>
                <div class='w-full'>
                    <label
                        for='tipo_usuario_id_user_create'
                        class='block mb-2 text-sm font-medium text-gray-900 text-start'
                    >Tipo de Usuario</label>
                    <select
                        name='tipo_usuario_id'
                        data-valid='text'
                        id='tipo_usuario_id_user_create'
                        class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                        placeholder='Ingrese el Proveedor'
                        required
                    >
                        <option value=''>Seleccione un Tipo de Usuario</option>

                    </select>
                </div>
            </div>

            <div class='w-full'>
                <label
                    for='password_user_create'
                    class='block mb-2 text-sm font-medium text-gray-900 text-start'
                >Contraseña</label>
                <input
                    type='password'
                    name='password'
                    data-valid='password'
                    id='password_user_create'
                    autocomplete='new-password'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    placeholder='Ingrese la Contraseña'
                    required
                />
                <span class='text-xs text-gray-500'>Debe contener al menos 8 caracteres, incluyendo mayúsculas,
                    minúsculas, números y símbolos</span>
            </div>
            <div class=''>
                <label
                    for='empleado_id_user_create'
                    class='block mb-2 text-sm font-medium text-gray-900 text-start'
                >Empleado</label>
                <select
                    name='empleado_id'
                    data-valid='text'
                    id='empleado_id_user_create'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    placeholder='Ingrese el Proveedor'
                    required
                >
                    <option value=''>Seleccione un Empleado</option>

                </select>
            </div>
            <div class=''>
                <label for='activo_box_create' class='block mb-2 text-sm font-medium text-gray-900'>
                    Método activo
                </label>
                <label class='inline-flex items-center cursor-pointer relative'>
                    <!-- input invisible -->
                    <input
                        type='checkbox'
                        data-valid='boolean'
                        id='activo_box_create'
                        name='activo'
                        class='sr-only peer'
                    />

                    <!-- fondo del switch -->
                    <div
                        class='w-11 h-6 bg-gray-300 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-blue-500 rounded-full peer peer-checked:bg-green-500 relative transition-colors duration-300'
                    >
                        <!-- pelotica -->
                    </div>
                    <div
                        class='absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full transition-transform duration-300 peer-checked:translate-x-5'
                    ></div>

                    <!-- texto al lado -->
                    <span class='ml-3 text-sm text-gray-700'>Activo</span>
                </label>
            </div>
        </div>
        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>
            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400 cursor-pointer'
            >
                Cancelar
            </button>
            {{> components/submit-btn icon='person_add' label='Registrar'}}
        </div>
    </form>
</div>
