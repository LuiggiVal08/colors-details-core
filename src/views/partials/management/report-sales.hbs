<div class='bg-red-100 shadow-lg rounded-lg p-6 w-full flex-col gap-4 flex'>
    <div class='flex flex-row items-center justify-between'>
        <div>
            <div class='flex flex-row gap-2'>
                <span data-ico='calendar_month' class='material-symbols-rounded md-28'></span>
                <h3 class='text-xl font-medium text-gray-900'>Generar Reporte</h3>
            </div>
            <span>Seleccione el rango de fechas para generar el reporte</span>
        </div>
    </div>

    <div class='flex flex-col md:flex-row gap-4 w-full'>

        <form action='/shopping/report' data-noreload='false' method='post'>
            <div class='w-full'>
                <label for='fecha_inicio' class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                    Fecha de Inicio
                </label>
                <input
                    type='date'
                    data-valid='date'
                    name='fecha_inicio'
                    id='fecha_inicio'
                    class='bg-red-300/30 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    required
                />
            </div>

            <div class='mt-4 w-full'>
                <label for='fecha_fin' class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                    Fecha de Fin
                </label>
                <input
                    type='date'
                    data-valid='date'
                    name='fecha_fin'
                    id='fecha_fin'
                    class='bg-red-300/30 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    required
                />
                <span class='text-xs text-gray-500'>Debe seleccionar un rango válido donde la fecha final sea igual o
                    mayor a la fecha inicial.</span>
            </div>

            <div class='mt-4 flex items-center'>
{{> components/submit-btn icon='description' label='Generar Reporte' class='w-full'}}
            </div>
        </form>

        <div class='rounded-lg h-fit bg-red-400/20 w-full p-4 border border-red-400 border-dashed'>
            <div class='flex flex-row items-center gap-1'>
                <span data-ico='info' class='material-symbols-rounded md-18 text-red-500 leading-none'></span>
                <span class='font-semibold'>Recomendaciones:</span>
            </div>
            <ul class='list-disc list-inside text-sm text-gray-700'>
                <li>Seleccione fechas válidas</li>
                <li>Evite rangos demasiado amplios</li>
                <li>Verifique que ambas fechas pertenezcan al mismo año si aplica</li>
                <li>Use este reporte solo para consultas oficiales</li>
            </ul>
        </div>

    </div>
</div>
