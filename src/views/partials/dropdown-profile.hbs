<div class='relative'>
    <button type='button'
        class='flex items-center focus:outline-none cursor-pointer leading-0 rounded-full overflow-hidden size-8 ring-2 ring-pink-200 hover:ring-pink-400 transition-all'
        id='btn-profile'
        aria-label='Menú de perfil'>
        <img src='/img/profile-default.png' alt='' class='w-full h-full object-cover' />
    </button>
    <div class='absolute right-0 mt-2 top-full w-52 bg-white rounded-xl shadow-lg border border-gray-100 z-20 py-2 hidden'
        id='profile-dropdown'>
        <a href='/profile'
            class='text-gray-700 h-12 w-full hover:bg-pink-50 flex items-center justify-start hover:border-l-4 border-pink-500 pl-4 duration-200 text-sm'>
            Perfil
        </a>
        {{#with user}}
            {{#if this.superadmin}}
                <a href='/management'
                    class='text-gray-700 h-12 w-full hover:bg-pink-50 flex items-center justify-start hover:border-l-4 border-pink-500 pl-4 duration-200 text-sm'>
                    Mantenimiento
                </a>
            {{/if}}
            {{#if this.admin}}
                <a href='/settings'
                    class='text-gray-700 h-12 w-full hover:bg-pink-50 flex items-center justify-start hover:border-l-4 border-pink-500 pl-4 duration-200 text-sm'>
                    Configuración
                </a>
            {{/if}}
        {{/with}}
        <hr class='my-1 border-gray-100'>
        <button id='logout-btn-aside'
            class='text-gray-700 h-12 w-full hover:bg-pink-50 flex items-center justify-start hover:border-l-4 border-pink-500 pl-4 duration-200 text-sm cursor-pointer'>
            Cerrar Sesión
        </button>
    </div>
</div>
<script src='/js/partials/dropdownProfile.js' type='module'></script>
