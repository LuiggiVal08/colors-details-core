<div
    id='modal-create-cash-movement'
    class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden'
    inert
>

    <form
        class='bg-white rounded-lg shadow-lg max-w-lg m-auto overflow-auto max-h-[100vh] relative'
        action='/cash-movements'
        data-method='POST'
        id='form-cash-movement'
    >
        <input type='hidden' name='caja_id' data-valid='text' value='{{caja.id}}' />
        <!-- Header -->
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 class='text-xl font-medium text-gray-900'>Registrar Movimiento de Caja</h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-red-500'
            ></button>
        </div>

        <!-- Body -->
        <div role='dialog' class='p-6 space-y-4'>

            <!-- Tipo -->
            <div>
                <label class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                    Tipo de movimiento
                </label>
                <select
                    name='tipo'
                    data-valid='text'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    required
                >
                    <option disabled selected value=''>Seleccione</option>
                    <option value='ingreso'>Ingreso</option>
                    <option value='egreso'>Egreso</option>
                </select>
            </div>

            <!-- Monto -->
            <div>
                <label for='monto' class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                    Monto
                </label>
                <input
                    type='text'
                    id='monto'
                    name='monto'
                    data-valid='float'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    placeholder='Ej. 25.50'
                    required
                />
            </div>

            <!-- Descripción -->
            <div>
                <label for='descripcion' class='block mb-2 text-sm font-medium text-gray-900 text-start'>
                    Descripción
                </label>
                <textarea
                    id='descripcion'
                    name='descripcion'
                    data-valid='text'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    placeholder='Motivo del movimiento'
                    required
                ></textarea>
            </div>

        </div>

        <!-- Footer -->
        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>

            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400 cursor-pointer'
            >
                Cancelar
            </button>

            <button
                data-confirm='modal'
                type='submit'
                class='inline-block bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 cursor-pointer'
            >
                Registrar Movimiento
            </button>

        </div>

    </form>
</div>
