<div id='modal-control-caja' class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden' inert>
    <form
        id='form-control-caja'
        class='bg-white rounded-lg shadow-lg max-w-lg m-auto overflow-auto max-h-[100vh] relative'
        method='POST'
    >
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 id='controlCajaTitulo' class='text-xl font-medium text-gray-900'>
                Control de Caja
            </h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-red-500'
            ></button>
        </div>

        <div role='dialog' class='p-6'>
            <input type='hidden' name='caja_id' id='controlCajaId' />

            <div class='mb-4'>
                <p class='text-sm text-gray-700'>
                    <strong>Estado Actual:</strong>
                    <span id='controlCajaEstado' class='font-medium text-gray-900'></span>
                </p>
            </div>

            <div id='infoControlActual' class='hidden'>
                <div class='mt-4'>
                    <p class='text-sm text-gray-600'>
                        <strong>Fecha de Apertura:</strong>
                        <span id='controlCajaFechaApertura'></span>
                    </p>
                </div>

                <div class='mt-2'>
                    <p class='text-sm text-gray-600'>
                        <strong>Monto de Apertura:</strong>
                        <span id='controlCajaMontoApertura'></span>
                    </p>
                </div>
                <div class='mt-2'>
                    <p class='text-sm text-gray-600'>
                        <strong>Monto en Caja:</strong>
                        <span id='controlCajaMonto'></span>
                    </p>
                </div>
            </div>

            <div class='mt-6 p-4 bg-red-100 border border-red-300 rounded-lg' id='mensajeConfirmacion'>
                <!-- mensaje dinámico -->
            </div>
        </div>

        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>
            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400 cursor-pointer'
            >
                Cancelar
            </button>

            <button
                type='submit'
                id='btnSubmitControlCaja'
                class='inline-block bg-red-400 hover:bg-red-500 text-white px-4 py-2 rounded-md cursor-pointer'
            ></button>
        </div>
    </form>
</div>

<script type='module' src='/js/pages/box-register/controller.js'></script>
