<div id='modal-pay-service' class='fixed top-0 left-0 h-screen w-full bg-black/50 z-20 content-center hidden' inert>
    <form
        class='bg-white rounded-lg shadow-lg max-w-lg m-auto overflow-auto max-h-[100vh] relative'
        action='/service-payment'
        data-method='POST'
    >
        <!-- HEADER -->
        <div
            role='heading'
            class='w-full flex justify-between items-center px-6 py-4 border-b border-gray-200 sticky top-0 bg-white z-10'
        >
            <h2 class='text-xl font-medium text-gray-900'>Registrar Pago del Servicio</h2>
            <button
                type='button'
                data-dismiss='modal'
                data-ico='cancel'
                class='material-symbols-rounded cursor-pointer flex hover:text-red-500'
            ></button>
        </div>

        <!-- BODY -->
        <div role='dialog' class='p-6 space-y-4'>
            <!-- ID oculto del período -->
            <input
                type='hidden'
                name='payment_service_id'
                id='payment_service_id'
                data-field='service-id'
                class='inputError'
                value='{{service.id}}'
            />

            <!-- Monto a Pagar -->
            <div>
                <label for='monto_pago_service' class='block mb-2 text-sm font-medium text-gray-900 text-start'>Monto a
                    Pagar (USD)</label>
                <input
                    type='text'
                    name='monto'
                    data-valid='float'
                    id='monto_pago_service'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none text-right'
                    placeholder='0,00'
                    required
                />
            </div>

            <!-- Fecha de Pago -->
            <div>
                <label for='fecha_pago_service' class='block mb-2 text-sm font-medium text-gray-900 text-start'>Fecha de
                    Pago</label>
                <input
                    type='date'
                    name='fecha_pago'
                    data-valid='text'
                    id='fecha_pago_service'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    required
                />
            </div>

            <!-- Comentario -->
            <div>
                <label
                    for='descripcion_pago_service'
                    class='block mb-2 text-sm font-medium text-gray-900 text-start'
                >Comentario</label>
                <textarea
                    name='descripcion'
                    id='descripcion_pago_service'
                    data-valid='text'
                    class='bg-red-100/50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-400 focus:border-red-400 block w-full p-2 outline-none'
                    placeholder='Nota adicional del pago'
                ></textarea>
            </div>
        </div>

        <!-- FOOTER -->
        <div role='doc-footnote' class='px-6 py-2 border-t border-gray-200 flex items-center justify-end gap-4'>
            <button
                data-dismiss='modal'
                type='button'
                class='inline-block bg-transparent text-gray-500 px-4 py-2 rounded-md hover:bg-gray-400/50 border border-gray-400 cursor-pointer'
            >
                Cancelar
            </button>
            <button
                data-confirm='modal'
                type='submit'
                class='inline-block bg-red-400 hover:bg-red-500 text-white px-4 py-2 rounded-md cursor-pointer'
            >
                Registrar Pago
            </button>
        </div>
    </form>
</div>
