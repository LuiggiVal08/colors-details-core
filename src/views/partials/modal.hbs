<template id='template-modal-confirm'>
    <div class='fixed inset-0 h-screen w-full bg-black/50 z-20 content-center hidden' aria-hidden='true'>
        <div class='bg-white rounded-xl shadow-2xl max-w-lg mx-auto' role='dialog' aria-modal='true' aria-labelledby='modal-title'>
            <div class='flex justify-between items-center px-6 py-4 border-b border-gray-200'>
                <h2 id='modal-title' class='text-xl font-semibold text-gray-900'>Confirmación</h2>
                <button data-dismiss='modal' data-ico='cancel'
                    class='material-symbols-rounded cursor-pointer hover:text-red-500 transition-colors'
                    aria-label='Cerrar'></button>
            </div>
            <div class='p-6 text-gray-700'></div>
            <div class='px-6 py-3 border-t border-gray-200 flex items-center justify-end gap-3'>
                <button data-dismiss='modal'
                    class='px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors cursor-pointer'>
                    Cancelar
                </button>
                <button data-confirm='modal'
                    class='px-4 py-2 text-sm font-medium text-white bg-pink-500 rounded-lg hover:bg-pink-600 transition-colors cursor-pointer'>
                    Confirmar
                </button>
            </div>
        </div>
    </div>
</template>
